{
    "interface_version": 2,
    "name": "MWJDR",
    "github": "https://github.com/l0rraine/MWJDR",
    "controller": [
        {
            "name": "ADB",
            "label": "模拟器",
            "type": "Adb"
        },
        {
            "name": "Scrcpy",
            "label": "Scrcpy",
            "type": "Win32",
            "win32": {
                "class_regex": "^SDL_app$",
                "window_regex": "无尽冬日.*",
                "screencap": "FramePool",
                "mouse": "PostMessageWithCursorPos",
                "keyboard": "PostMessageWithCursorPos"
            },
            "permission_required": true
        },
        {
            "name": "PlayCover",
            "type": "PlayCover"
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "{PROJECT_DIR}/resource/base"
            ]
        }
    ],
    "agent": {
        "child_exec": "{PROJECT_DIR}/../agent-go/agent-go.exe",
        "child_args": []
    },
    "task": [],
    "option": {},
    "import": [
        "resource/tasks/preset/Daily.json",
        "resource/tasks/preset/Activity.json",
        "resource/tasks/preset/Standalone.json",
        "resource/tasks/自动游历.json",
        "resource/tasks/启动游戏.json",
        "resource/tasks/自动灯塔.json",
        "resource/tasks/集结巨兽.json",
        "resource/tasks/使用物品集结.json",
        "resource/tasks/自动野兽.json",
        "resource/tasks/结束.json",
        "resource/tasks/商店购买.json",
        "resource/tasks/海岛协助打理.json",
        "resource/tasks/联盟总动员.json",
        "resource/tasks/梦境寻忆.json",
        "resource/tasks/打熊.json",
        "resource/tasks/新手.json",
        "resource/tasks/王城驻防.json",
        "resource/tasks/投壶.json"
    ]
}
